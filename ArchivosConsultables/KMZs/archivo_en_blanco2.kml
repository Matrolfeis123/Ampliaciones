                    &lt;div style="overflow: auto; text-align: justify"&gt;
                    $[Amp_200/patio1_conexiones]
                    &lt;/div&gt;
                    &lt;/td&gt;
                    &lt;td&gt;$[Amp_200/patio1_posiciones_disponibles]&lt;/td&gt;
