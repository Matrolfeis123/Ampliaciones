        <ns0:Style id="ONva_100_l">
            <ns0:IconStyle>
                <ns0:scale>1.16667</ns0:scale>
                <ns0:Icon>
                    <ns0:href>files/add_9.png</ns0:href>
                </ns0:Icon>
            </ns0:IconStyle>
            <ns0:LabelStyle>
                <ns0:color>00ffffff</ns0:color>
            </ns0:LabelStyle>
            <ns0:BalloonStyle>
                <ns0:text>

                    &lt;style&gt;
                    .card_1 {
                    max-width: 500px; /* Ancho máximo de la tarjeta */
                    max-height: 500px; /* Altura máxima de la tarjeta */
                    overflow-x: auto; /* Scroll horizontal si es necesario */
                    overflow-y: auto; /* Scroll vertical si es necesario */
                    margin-top: 10px; /* Espacio superior */
                    text-align: justify; /* Alineación justificada del texto */
                    }

                    .card_1 td, .card_1 th {
                    padding: 4px; /* Espaciado interno de las celdas */
                    }

                    .card_1 .field {
                    margin: 5px; /* Margen exterior */
                    padding-right: 10px; /* Espaciado derecho */
                    max-height: 70px; /* Altura máxima */
                    overflow: auto; /* Scroll si es necesario */
                    text-align: justify; /* Alineación justificada del texto */
                    }

                    .card_2 {
                    width: 100%; /* Utilizar todo el ancho disponible */
                    text-align: center; /* Centrar contenido horizontalmente */
                    margin-top: 10px; /* Espacio superior */
                    }

                    .card_2 img {
                    max-width: 100%; /* Asegurarse de que la imagen no exceda el ancho de la tarjeta
                    */
                    height: auto; /* Mantener la proporción de la imagen */
                    }

                    .card_2 .title {
                    font-size: 16px; /* Tamaño de fuente para el título */
                    margin-top: 10px; /* Espacio superior */
                    margin-bottom: 10px; /* Espacio inferior */
                    background-color: #8bb145; /* Color de fondo */
                    color: #ffffff; /* Color del texto */
                    }

                    /* Estilo para la primera tabla */
                    .table1 {
                    width: 100%; /* Ancho completo */
                    margin-top: 10px; /* Espacio superior */
                    text-align: justify; /* Alineación justificada del texto */
                    }

                    .table1 td, .table1 th {
                    padding: 4px; /* Espaciado interno de las celdas */
                    text-align: left; /* Alineación del texto a la izquierda */
                    }

                    .table2 {
                    width: 100%; /* Ancho completo */
                    margin-top: 10px; /* Espacio superior */
                    text-align: center; /* Alineación centrada del texto */
                    }

                    .table2 th {
                    background-color: #AAAAAA; /* Color de fondo para encabezados */
                    color: #000000; /* Color del texto en encabezados */
                    padding: 4px; /* Espaciado interno de las celdas */
                    }

                    .table2 td {
                    background-color: #FFFFFF; /* Color de fondo para celdas */
                    color: #000000; /* Color del texto en celdas */
                    padding: 4px; /* Espaciado interno de las celdas */
                    }

                    .table2 .field {
                    max-height: 70px; /* Altura máxima */
                    overflow: auto; /* Scroll si es necesario */
                    text-align: justify; /* Alineación justificada del texto */
                    }

                    &lt;/style&gt;

                    &lt;table class="card_2" border="0" cellpadding="0" cellspacing="1"
                    summary=""&gt;
                    &lt;tr&gt;
                    &lt;td valign="middle" align="center"&gt;
                    &lt;img src="files/trinergy_13.jpg" border="0" width="240" height="90"
                    alt=""&gt;
                    &lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                    &lt;td valign="middle" align="center"&gt;
                    &lt;div class="title"&gt;NUEVA SUBESTACIÓN&lt;/div&gt;
                    &lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;/table&gt;

                    &lt;table class="card_1 table1" border="1"&gt;
                    &lt;tr&gt;
                    &lt;td bgcolor="#AAAAAA"&gt;&lt;b&gt;Nombre&lt;/b&gt;&lt;/td&gt;
                    &lt;td&gt;$[ONva_100_l/OBRA]&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                    &lt;td bgcolor="#AAAAAA"&gt;&lt;b&gt;Decreto&lt;/b&gt;&lt;/td&gt;
                    &lt;td&gt;$[ONva_100_l/DECRETO]&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                    &lt;td bgcolor="#AAAAAA"&gt;&lt;b&gt;Tipo&lt;/b&gt;&lt;/td&gt;
                    &lt;td&gt;$[ONva_100_l/TIPO]&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                    &lt;td bgcolor="#AAAAAA"&gt;&lt;b&gt;Valor Inversion&lt;/b&gt;&lt;/td&gt;
                    &lt;td&gt;$[ONva_100_l/VI]&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                    &lt;td bgcolor="#AAAAAA"&gt;&lt;b&gt;Entrada en Operacion&lt;/b&gt;&lt;/td&gt;
                    &lt;td&gt;$[ONva_100_l/ENTRADA_OP]&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                    &lt;td bgcolor="#AAAAAA"&gt;&lt;b&gt;Resumen&lt;/b&gt;&lt;/td&gt;
                    &lt;td&gt;
                    &lt;div class="field"&gt;$[ONva_100_l/RESUMEN]&lt;/div&gt;
                    &lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                    &lt;td bgcolor="#AAAAAA"&gt;&lt;b&gt;Licitación&lt;/b&gt;&lt;/td&gt;
                    &lt;td&gt;
                    &lt;div class="field"&gt;$[ONva_100_l/LICITACION]&lt;/div&gt;
                    &lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;/table&gt;

                    &lt;table class="card_1 table2" border="1"&gt;
                    &lt;tr&gt;
                    &lt;th&gt;Tipo&lt;/th&gt;
                    &lt;th&gt;Tensión&lt;/th&gt;
                    &lt;th&gt;Configuración&lt;/th&gt;
                    &lt;th&gt;Conexiones&lt;/th&gt;
                    &lt;th&gt;Posiciones Disponibles&lt;/th&gt;
                    &lt;/tr&gt;
                    &lt;tr&gt;
                    &lt;td&gt;$[ONva_100_l/patio1_tipo]&lt;/td&gt;
                    &lt;td&gt;$[ONva_100_l/patio1_tension]&lt;/td&gt;
                    &lt;td&gt;$[ONva_100_l/patio1_configuracion]&lt;/td&gt;
                    &lt;td&gt;
                    &lt;div class="field"&gt;$[ONva_100_l/patio1_conexiones]&lt;/div&gt;
                    &lt;/td&gt;
                    &lt;td&gt;$[ONva_100_l/patio1_posiciones_disponibles]&lt;/td&gt;
                    &lt;/tr&gt;
                    &lt;/table&gt;
                </ns0:text>
            </ns0:BalloonStyle>
        </ns0:Style>

