            <ns0:Placemark>
                <ns0:name>Nueva S/E Río Viejo</ns0:name>
                <ns0:styleUrl>#ONva_200_l</ns0:styleUrl>
                <ns0:ExtendedData>
                    <ns0:SchemaData schemaUrl="#ONva_200_l">
                        <ns0:SimpleData name="OBRA">Nueva S/E Río Viejo</ns0:SimpleData>
                        <ns0:SimpleData name="DECRETO">PET Preliminar 2024</ns0:SimpleData>
                        <ns0:SimpleData name="TIPO">Nueva S/E</ns0:SimpleData>
                        <ns0:SimpleData name="VI">Sin información a la fecha</ns0:SimpleData>
                        <ns0:SimpleData name="ENTRADA_OP">Sin información a la fecha</ns0:SimpleData>
                        <ns0:SimpleData name="LICITACION">La adjudicación de esta obra
                            quedará condicionada a la adjudicación de las obras
                            “Aumento de capacidad línea 1x154 kV Río Viejo –
                            Pueblo Seco – Charrúa” y “Aumento de capacidad de
                            línea 1x154 kV Río Viejo – Pueblo Seco –
                            Charrúa, tramo Pueblo Seco – Punto de seccionamiento de
                            línea”, individualizadas en los numerales 4.1.10 y 4.1.11
                            respectivamente del presente Informe.</ns0:SimpleData>
                        <ns0:SimpleData name="RESUMEN">El proyecto consiste en la construcción
                            de una nueva subestación, denominada Río Viejo, mediante el
                            seccionamiento de las líneas 1x154 kV Monterrico – Montenegro
                            y 1x154 kV Pueblo Seco – Chillán con sus respectivos
                            paños de línea y patios de 154 kV y 66 kV.</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_tipo">Construccion Patio</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_tension">patio 154 kV</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_configuracion">doble barra principal y barra de
                            transferencia</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_conexiones">['los dos equipos de
                            transformación 154/66 kV', 'conexión del seccionamiento de la
                            línea 1x154 kV Monterrico – Montenegro', 'conexión del
                            seccionamiento de la línea 1x154 kV Pueblo Seco –
                            Chillán', 'conexión de un banco de condensadores',
                            'construcción de un paño acoplador', 'construcción de un
                            paño seccionador de barras', 'conexión de nuevos proyectos en
                            la zona.']</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_posiciones_disponibles">Buscar en Informe</ns0:SimpleData>
                        <ns0:SimpleData name="patio2_tipo">Construccion Patio</ns0:SimpleData>
                        <ns0:SimpleData name="patio2_tension">patio 66 kV</ns0:SimpleData>
                        <ns0:SimpleData name="patio2_configuracion">barra principal seccionada y
                            barra de transferencia</ns0:SimpleData>
                        <ns0:SimpleData name="patio2_conexiones">['los dos equipos de
                            transformación 154/66 kV', 'conexión de la línea asociada
                            a la obra “Nueva S/E Guangualí y nueva línea 2x66 kV
                            Guangualí – Río Viejo”', 'construcción de un
                            paño acoplador', 'construcción de un paño seccionador de
                            barras', 'conexión de nuevos proyectos en la zona.']</ns0:SimpleData>
                        <ns0:SimpleData name="patio2_posiciones_disponibles">4</ns0:SimpleData>
                    </ns0:SchemaData>
                </ns0:ExtendedData>
                <ns0:Point>
                    <ns0:coordinates>-72.095671,-36.760636</ns0:coordinates>
                </ns0:Point>
            </ns0:Placemark>
