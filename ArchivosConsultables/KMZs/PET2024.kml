            <ns0:Placemark>
                <ns0:name>Ampliación en S/E San Clemente 66 kV (BS)</ns0:name>
                <ns0:styleUrl>#Amp_100</ns0:styleUrl>
                <ns0:ExtendedData>
                    <ns0:SchemaData schemaUrl="#Amp_100">
                        <ns0:SimpleData name="OBRA">Ampliación en S/E San Clemente 66 kV (BS)</ns0:SimpleData>
                        <ns0:SimpleData name="DECRETO">PET Final 2023</ns0:SimpleData>
                        <ns0:SimpleData name="TIPO">Ampliación</ns0:SimpleData>
                        <ns0:SimpleData name="VI">Sin información a la fecha</ns0:SimpleData>
                        <ns0:SimpleData name="ENTRADA_OP">Sin información a la fecha</ns0:SimpleData>
                        <ns0:SimpleData name="RESUMEN">El proyecto consiste en la construcción de
                            una nueva barra de 66 kV en la subestación San Clemente, en
                            configuración barra simple, la cual deberá considerar espacio en barra y
                            plataforma para tres posiciones, de manera de permitir la conexión del
                            transformador existente y la conexión del seccionamiento de línea
                            asociado a la obra “Aumento de capacidad línea 1x66 kV El Ruil – San
                            Ignacio y seccionamiento de línea en S/E San Clemente”.</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_tipo">construcción nueva barra</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_tension">nueva barra 66 kV</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_configuracion">barra simple</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_conexiones">['transformador existente',
                            'conexión del seccionamiento de línea asociado a la obra “Aumento de
                            capacidad línea 1x66 kV El Ruil – San Ignacio y seccionamiento de línea
                            en S/E San Clemente”.']</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_posiciones_disponibles">0</ns0:SimpleData>
                        <ns0:SimpleData name="parrafo1">N/A</ns0:SimpleData>
                    </ns0:SchemaData>
                </ns0:ExtendedData>
                <ns0:Point>
                    <ns0:coordinates>-71.570667,-35.536144, 0</ns0:coordinates>
                </ns0:Point>
            </ns0:Placemark>
            <ns0:Placemark>
                <ns0:name>Ampliación en S/E El Empalme 110 kV (BP+BT), nuevo patio 220 kV (IM) y
                    nuevo transformador</ns0:name>
                <ns0:styleUrl>#Amp_200</ns0:styleUrl>
                <ns0:ExtendedData>
                    <ns0:SchemaData schemaUrl="#Amp_200">
                        <ns0:SimpleData name="OBRA">Ampliación en S/E El Empalme 110 kV (BP+BT),
                            nuevo patio 220 kV (IM) y nuevo transformador</ns0:SimpleData>
                        <ns0:SimpleData name="DECRETO">PET Final 2023</ns0:SimpleData>
                        <ns0:SimpleData name="TIPO">Ampliación</ns0:SimpleData>
                        <ns0:SimpleData name="VI">Sin información a la fecha</ns0:SimpleData>
                        <ns0:SimpleData name="ENTRADA_OP">Sin información a la fecha</ns0:SimpleData>
                        <ns0:SimpleData name="RESUMEN">El proyecto consiste en la ampliación de
                            barras e instalaciones comunes del patio de 110 kV de la subestación El
                            Empalme, cuya configuración corresponde a barra simple, para al menos
                            tres nuevas posiciones, de manera de permitir la conexión de un nuevo
                            banco de autotransformadores 220/110 kV, la conexión de un paño
                            acoplador de barras y la conexión de un paño de línea. A su vez, el
                            proyecto contempla la construcción de una nueva barra de transferencia
                            junto con todas las obras, adecuaciones y refuerzos necesarios para
                            completar los paños de línea en 110 kV existentes, de forma tal que
                            estos se adapten a la nueva configuración de barras del patio la cual
                            corresponderá a barra principal con barra de transferencia.
                            Adicionalmente, el proyecto incluye la construcción de un nuevo patio de
                            220 kV en la subestación El Empalme, en configuración interruptor y
                            medio, con una capacidad de barras de, al menos, 500 MVA con 75°C en el
                            conductor y 35°C temperatura ambiente con sol, donde se deberá
                            considerar espacio en barras y plataforma para tres diagonales, de
                            manera de permitir la conexión de un nuevo banco de autotransformadores
                            220/110 kV, la conexión del seccionamiento de la línea 1x220 kV
                            Melipulli – Pargua y la conexión de nuevos proyectos en la zona. Junto
                            con lo anterior, el proyecto contempla la instalación de un banco de
                            autotransformadores 220/110 kV de, al menos, 150 MVA con Cambiador de
                            Derivación Bajo Carga (CDBC) con unidad de reserva, la cual deberá
                            contar con conexión automática, y sus respectivos paños de conexión en
                            ambos niveles de tensión. Finalmente, el proyecto considera el
                            seccionamiento de la línea 1x220 kV Melipulli – Pargua en el nuevo patio
                            de 220 kV de la subestación El Empalme mediante la construcción de los
                            respectivos paños de línea y los enlaces que corresponda, los cuales
                            deberán mantener, al menos, las características técnicas de la línea que
                            se secciona.</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_tipo">ampliación barra</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_tension">patio 220 kV</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_configuracion">barra simple</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_conexiones">['un nuevo banco de
                            autotransformadores 220/110 kV', 'conexión de un paño acoplador de
                            barras', 'conexión de un paño de línea.']</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_posiciones_disponibles">2</ns0:SimpleData>
                        <ns0:SimpleData name="patio2_tipo">construcción nueva barra</ns0:SimpleData>
                        <ns0:SimpleData name="patio2_tension">Buscar en Informe</ns0:SimpleData>
                        <ns0:SimpleData name="patio2_configuracion">barra principal con barra de
                            transferencia</ns0:SimpleData>
                        <ns0:SimpleData name="patio2_conexiones">Revisar manualmente, al parecer no
                            hay conexiones en el texto.</ns0:SimpleData>
                        <ns0:SimpleData name="patio2_posiciones_disponibles">Buscar en Informe</ns0:SimpleData>
                        <ns0:SimpleData name="parrafo1">N/A</ns0:SimpleData>
                    </ns0:SchemaData>
                </ns0:ExtendedData>
                <ns0:Point>
                    <ns0:coordinates>-73.222434,-41.584333, 0</ns0:coordinates>
                </ns0:Point>
            </ns0:Placemark>
