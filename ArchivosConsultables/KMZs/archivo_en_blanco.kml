            <ns0:Placemark>
                <ns0:name>Ampliación en S/E Cóndores 110 kV (BP+BT) </ns0:name>
                <ns0:styleUrl>#Amp_100</ns0:styleUrl>
                <ns0:ExtendedData>
                    <ns0:SchemaData schemaUrl="#Amp_100">
                        <ns0:SimpleData name="OBRA">Ampliación en S/E Cóndores 110 kV (BP+BT) </ns0:SimpleData>
                        <ns0:SimpleData name="DECRETO">PET Final 2023</ns0:SimpleData>
                        <ns0:SimpleData name="TIPO">Ampliación</ns0:SimpleData>
                        <ns0:SimpleData name="VI">1.579.763 dólares</ns0:SimpleData>
                        <ns0:SimpleData name="ENTRADA_OP">a más tardar, dentro de los 54 meses
                            siguientes a la fecha de publicación en el Diario Oficial del respectivo
                            decreto</ns0:SimpleData>
                        <ns0:SimpleData name="RESUMEN">El proyecto consiste en la ampliación de las
                            barras e instalaciones comunes del patio de 110 kV de la subestación
                            Cóndores, cuya configuración corresponde a barra principal con barra de
                            transferencia, para dos nuevas posiciones, de manera de permitir la
                            conexión de la obra “Nueva S/E Alto Molle y nueva línea 2x110 kV Alto
                            Molle – Cóndores”.</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_tipo">ampliación barra</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_tension">patio 110 kV</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_configuracion">barra principal con barra de
                            transferencia</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_conexiones">['la obra “Nueva S/E Alto Molle y
                            nueva línea 2x110 kV Alto Molle – Cóndores”.']</ns0:SimpleData>
                        <ns0:SimpleData name="patio1_posiciones_disponibles">0</ns0:SimpleData>
                    </ns0:SchemaData>
                </ns0:ExtendedData>
                <ns0:Point>
                    <ns0:coordinates>-70.0794108,-20.24832586, 0</ns0:coordinates>
                </ns0:Point>
            </ns0:Placemark>
